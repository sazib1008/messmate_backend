# ==============================================================================
# MessMate Backend Environment Variables (Example Template)
# Copy this file to .env and configure your local/production values.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL / Neon)
DB_URL=jdbc:postgresql://localhost:5432/messmate?sslmode=prefer
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Connection Pool (HikariCP)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_IDLE_TIMEOUT=30000
DB_MAX_LIFETIME=60000
DB_CONNECTION_TIMEOUT=30000

# JPA & Hibernate
JPA_DDL_AUTO=update
SHOW_SQL=false

# Security & JWT (Generate a 256-bit or 512-bit hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=604800000
