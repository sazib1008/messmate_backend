# ==============================================================================
# MessMate Backend .gitignore
# ==============================================================================

# Environment and Secrets (CRITICAL: Do NOT commit secrets!)
.env
.env.*
!.env.example
*firebase*.json
*.keystore
*.jks

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Kotlin compiler cache
.kotlin/

# Output directories & compiled binaries
bin/
out/
!**/src/main/**/bin/
!**/src/test/**/bin/
!**/src/main/**/out/
!**/src/test/**/out/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
*.idea

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Logs & monitoring
logs/
*.log

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Documentation / temporary scratch files
HELP.md
*.tmp
